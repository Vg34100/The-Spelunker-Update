{
  "multipart": [
    {
      "apply": {
        "model": "spelunkery:block/bronze_bars_post"
      }
    },
    {
      "when": {
        "north": true
      },
      "apply": {
        "model": "spelunkery:block/bronze_bars_side"
      }
    },
    {
      "when": {
        "east": true
      },
      "apply": {
        "model": "spelunkery:block/bronze_bars_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": true
      },
      "apply": {
        "model": "spelunkery:block/bronze_bars_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": true
      },
      "apply": {
        "model": "spelunkery:block/bronze_bars_side",
        "y": 270
      }
    },
    {
      "when": {
        "north": false
      },
      "apply": {
        "model": "spelunkery:block/bronze_bars_cap"
      }
    },
    {
      "when": {
        "east": false
      },
      "apply": {
        "model": "spelunkery:block/bronze_bars_cap",
        "y": 90
      }
    },
    {
      "when": {
        "south": false
      },
      "apply": {
        "model": "spelunkery:block/bronze_bars_cap",
        "y": 180
      }
    },
    {
      "when": {
        "west": false
      },
      "apply": {
        "model": "spelunkery:block/bronze_bars_cap",
        "y": 270
      }
    }
  ]
}
